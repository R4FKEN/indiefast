{
  "name": "template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:full": "npm run dev",
    "server": "nodemon server.js",
    "sync:tools": "node scripts/export-tools.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run generate:sitemap && npm run generate:llms && vite build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:prod": "npm run build && vite preview"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@netlify/functions": "^5.2.1",
    "airtable": "^0.12.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.33.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "puppeteer": "^25.3.0",
    "react-helmet-async": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.1.3"
  }
}
